# Postgres connection string. Leave unset for local dev to use SQLite instead.
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Shared secret the practitioner review queue (static/index.html) sends
# as the X-API-Key header. Change this before deploying.
PRACTITIONER_API_KEY=change-me-before-deploying

# Secret used to sign account login tokens. Change this before deploying,
# anyone with this value could forge a login for any account.
JWT_SECRET=change-me-before-deploying-jwt-secret

# The domain your quiz front end will be hosted on, once it has one.
FRONTEND_ORIGIN=*

# Resend API key for sending the report-ready email. Leave unset to run
# in stub mode, where sends are logged instead of actually delivered.
RESEND_API_KEY=
EMAIL_FROM=reports@yourclinic.com

# Base URL of the /portal pages (signup/login/account), used to build
# the link inside the report-ready email. Defaults to this backend's
# own /portal path, which works out of the box with no separate hosting.
PORTAL_BASE_URL=https://womens-health-backend.onrender.com/portal

# Your WhatsApp community invite link, shown on the account page.
WHATSAPP_COMMUNITY_URL=https://chat.whatsapp.com/replace-with-your-invite-link
