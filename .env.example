# Postgres connection string. Leave unset for local dev to use SQLite instead.
# For production, use your Supabase connection string, matching CMC Connect's setup.
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Shared secret the practitioner review queue (static/admin.html) sends
# as the X-API-Key header. Change this before deploying.
PRACTITIONER_API_KEY=change-me-before-deploying

# The domain your quiz front end will be hosted on, once it has one,
# e.g. https://womens-health-quiz.netlify.app
# Leave unset (or "*") during local testing.
FRONTEND_ORIGIN=*

# Resend API key for sending the final report email. Leave unset to run
# in stub mode, where sends are logged instead of actually delivered.
RESEND_API_KEY=
